# =============================================================================
# Vast Cosmos — Environment Variables
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
#   cp .env.example .env.local
#
# Gere chaves seguras com: openssl rand -base64 32
# =============================================================================

# ─── Banco de Dados (PostgreSQL) ──────────────────────────────────────────────
# Conexão principal usada pelo Prisma (obrigatório)
POSTGRES_URL="postgresql://user:password@host:5432/db?pgbouncer=true&connection_limit=1"
# Conexão direta (sem pooler) para migrations e consultas diretas
DIRECT_URL="postgresql://user:password@host:5432/db"

# ─── Autenticação JWT ─────────────────────────────────────────────────────────
# Chave secreta para assinar/verificar tokens JWT (obrigatório)
# Gere com: openssl rand -base64 32
JWT_SECRET=""

# ─── Supabase (Storage + Auth) ────────────────────────────────────────────────
# URL do projeto Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
# Chave anônima pública do Supabase (obrigatório — segura para frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave de service role para operações administrativas (upload de imagens, etc.)
# Necessária para compressão de imagens via Sharp no servidor
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Upstash Redis (Rate Limiter) ──────────────────────────────────────────────
# URL e token do Redis REST API da Upstash.
# Necessário para rate limiting funcionar em produção (multi-servidor).
# Sem essas vars, o rate limiter usa fallback in-memory (apenas dev local).
# Crie uma conta grátis em: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://us1-xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# Next.js usa isso automaticamente. Não precisa definir manualmente.
# Valores: "development" | "production" | "test"
NODE_ENV="development"
