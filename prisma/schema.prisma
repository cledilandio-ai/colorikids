generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// MULTI-TENANT: Store é o tenant root. Todos os dados pertencem a uma Store.
// =============================================================================

model Store {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique // ex: "colorikids" — usado em URLs e identificação
  status      String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED, CANCELLED
  planType    String    @default("BASIC")  // BASIC, PRO (para futuras expansões)

  // Relações
  subscription  Subscription?
  users         User[]
  products      Product[]
  orders        Order[]
  customers     Customer[]
  cashRegisters CashRegister[]
  storeConfig   StoreConfig?
  treasuryTransactions TreasuryTransaction[]
  transactionCategories TransactionCategory[]
  stockMovements StockMovement[]
  inventoryLogs  InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id          String   @id @default(uuid())
  storeId     String   @unique
  store       Store    @relation(fields: [storeId], references: [id])
  status      String   @default("ACTIVE") // ACTIVE, OVERDUE, CANCELLED
  amount      Float    // Valor da mensalidade
  billingDay  Int      @default(1) // Dia do mês para cobrança
  nextDueDate DateTime
  notes       String?  // Observações manuais (ex: "Paga via Pix em 05/04")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// USER — Pertence a uma Store. Role SUPER_ADMIN não tem storeId (acesso global).
// =============================================================================

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   // SUPER_ADMIN, OWNER, SELLER
  maxDiscount Float    @default(0)
  permissions String[] @default([])
  shouldChangePassword Boolean @default(false)

  storeId     String?  // null apenas para SUPER_ADMIN
  store       Store?   @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// PRODUTOS
// =============================================================================

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Float
  costPrice   Float    @default(0)
  imageUrl    String?
  category    String?
  gender      String?
  supplier    String?

  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])

  variants    ProductVariant[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  size          String
  color         String?
  stockQuantity Int      @default(0)
  minStock      Int      @default(1)
  lastSoldAt    DateTime?
  lastRestockAt DateTime?
  sku           String?  @unique
  imageUrl      String?
  inventoryLogs InventoryLog[]
  stockMovements StockMovement[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =============================================================================
// CAIXA
// =============================================================================

model CashRegister {
  id            String   @id @default(uuid())
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  initialAmount Float
  finalAmount   Float?
  retainedAmount Float   @default(0)
  status        String   // OPEN, CLOSED
  userId        String?

  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])

  orders        Order[]
  transactions  CashTransaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CashTransaction {
  id              String       @id @default(uuid())
  amount          Float
  type            String       // IN, OUT
  description     String?
  cashRegisterId  String
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  createdAt       DateTime     @default(now())
}

// =============================================================================
// CLIENTES
// =============================================================================

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  cpf       String?
  email     String?
  address   String?

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  orders    Order[]
  receivables AccountReceivable[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cpf, storeId]) // CPF único por loja (não global)
}

// =============================================================================
// PEDIDOS
// =============================================================================

model Payment {
  id        String   @id @default(uuid())
  amount    Float
  method    String   // PIX, CASH, CREDIT, DEBIT, CREDIARIO
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model AccountReceivable {
  id          String   @id @default(uuid())
  amount      Float
  dueDate     DateTime
  status      String   // PENDING, PAID, OVERDUE
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  customerName  String
  customerPhone String?
  total         Float
  status        String   // PENDING, COMPLETED, CANCELLED
  type          String   // WEB, POS
  paymentMethod String?  // DEPRECATED: Use payments relation.
  items         String   // JSON string of items

  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])

  cashRegisterId String?
  cashRegister  CashRegister? @relation(fields: [cashRegisterId], references: [id])

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  payments      Payment[]
  receivables   AccountReceivable[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  active        Boolean  @default(true)
}

// =============================================================================
// CONFIGURAÇÃO DA LOJA (era singleton global, agora por Store)
// =============================================================================

model StoreConfig {
  id          String   @id @default(uuid())
  whatsapp    String   @default("5511999999999")
  whatsappMessage String @default("Olá! Vim pelo site e gostaria de saber mais.")
  companyName String   @default("Minha Loja")
  cnpj        String?
  instagram   String?
  pixKey      String?
  pixKeyType  String?
  featuredImageUrls String?

  storeId     String   @unique
  store       Store    @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// ESTOQUE
// =============================================================================

model InventoryLog {
  id        String   @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  change    Int
  reason    String
  userId    String?

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
}

model StockMovement {
  id              String         @id @default(uuid())
  type            String         // IN, OUT
  quantity        Int
  costPrice       Float?
  productVariantId String
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id])
  reason          String?

  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])

  createdAt       DateTime @default(now())
}

// =============================================================================
// FINANCEIRO / TESOURARIA
// =============================================================================

model TreasuryTransaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // IN, OUT
  category    String
  date        DateTime @default(now())
  userId      String?

  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TransactionCategory {
  id        String   @id @default(uuid())
  name      String
  type      String   // IN, OUT, BOTH

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, storeId]) // Nome único por loja
}

model RegistrationRequest {
  id              String   @id @default(uuid())
  storeName       String
  storeSlug       String   @unique
  ownerName       String
  ownerEmail      String
  ownerPassword   String   // Senha hashada
  phone           String?
  status          String   @default("PENDING") // PENDING, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =============================================================================
// PLATFORM — Configurações globais da plataforma SaaS (gerenciadas pelo Super Admin)
// =============================================================================

model PlatformConfig {
  id                  Int      @id @default(1) // Singleton — sempre 1 registro
  heroTitle           String   @default("Bem-vindo à nossa plataforma")
  heroSubtitle        String   @default("Gerencie sua loja com facilidade.")
  ctaText             String   @default("Acessar meu Painel")
  ctaLink             String   @default("/login")
  logoUrl             String?
  backgroundImageUrl  String?
  primaryColor        String   @default("#e91e8c")
  accentColor         String   @default("#9c27b0")
  platformName        String   @default("Vast Cosmos")
  contactEmail        String?
  socialLinks         String   @default("{}") // JSON: { instagram, whatsapp, facebook }
  platformInstagram   String?  // URL do Instagram da plataforma (campo direto)
  platformWhatsapp    String?  // Número WhatsApp da plataforma (campo direto)
  platformPixKey      String?  // Chave PIX da plataforma (Cobrança)
  platformPixName     String?  // Nome completo do titular do PIX
  platformPixCity     String?  // Cidade do titular do PIX (max 15 caracteres)
  platformPlanValue   Float    @default(49.90) // Valor da mensalidade da plataforma
  footerText          String?
  showActiveStores    Boolean  @default(true) // Exibir vitrine de lojas na home
  updatedAt           DateTime @updatedAt
}

